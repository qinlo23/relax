{
  "name": "kite-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kite/web --filter @kite/admin dev",
    "dev:web": "pnpm --filter @kite/web dev",
    "dev:admin": "pnpm --filter @kite/admin dev",
    "type-check": "pnpm -r type-check",
    "build": "pnpm --filter @kite/web --filter @kite/admin build",
    "build:web": "pnpm --filter @kite/web build",
    "build:admin": "pnpm --filter @kite/admin build",
    "preview": "pnpm --parallel --filter @kite/web --filter @kite/admin preview",
    "test:permissions": "node tests/permissions.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6",
    "@vue/tsconfig": "^0.9.1"
  }
}
